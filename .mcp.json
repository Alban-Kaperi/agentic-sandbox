{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.82", "--headless", "--isolated", "--image-responses", "omit"]
    },
    "cluster-snapshot": {
      "type": "stdio",
      "command": "node",
      "args": ["tools/cluster-snapshot-mcp/index.mjs"],
      "env": { "SNAPSHOT_PATH": "diag/snapshot.json" }
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@4.1.1"]
    }
  }
}
