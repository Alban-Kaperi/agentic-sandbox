    {
      "from": "pr",
      "to": "pipeline",
      "label": "every push",
      "variant": "emphasis"
    },
    {
      "from": "review",
      "to": "merge",
      "label": "findings"
    },
    {
      "from": "pipeline",
      "to": "merge",
      "label": "green",
      "variant": "emphasis"
    },
    {
      "from": "pipeline",
      "to": "diagnose",
      "label": "red",
      "variant": "security",
