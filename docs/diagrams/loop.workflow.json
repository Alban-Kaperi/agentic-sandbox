  "cards": [
    {
      "dot": "emerald",
      "title": "Two human gates",
      "items": [
        "Go: you read the plan before any code exists",
        "Merge: a person, always, after a green pipeline"
      ]
    },
    {
      "dot": "cyan",
      "title": "The agent does the rest",
      "items": [
        "Skills for plan, verify and diagnose",
        "A hook runs tsc after every edit",
        "A reviewer agent reads the diff, not the PR text"
      ]
    },
    {
      "dot": "rose",
      "title": "When the deploy is red",
      "items": [
        "Job summary and cluster snapshot are the evidence",
        "Name the root cause before changing code",
        "The work-ticket skill runs the whole row and stops at the gates"
      ]
    }
  ]
