{
  "name": "agentic-sandbox",
  "version": "1.0.0",
  "private": true,
  "description": "Measurement run log used as a sandbox for agentic software engineering workshops",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "verify": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@playwright/test": "^1.55.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5",
    "zod": "^4.6.5"
  }
}
